    "wear_scan": {
      "prefs_file": "<package>_preferences",
      "order": [
        "find /sys/block/mmcblk0/device/ -type f -name 'life_time*' | sed -e ':a;N;$!ba;s/\\n/ /g'",
        "find /dev/block/mmcblk0/device/ -type f -name 'life_time*' | sed -e ':a;N;$!ba;s/\\n/ /g'",
        "ls -1d /sys/devices/platform/soc/*ufshc*/health /sys/devices/platform/soc/*ufs*/health /sys/devices/platform/*ufshc*/health /sys/class/scsi_host/host*/device/health /sys/class/scsi_device/*/device/health /sys/block/sd*/device/health 2>/dev/null | head -n 1",
        "cat <health path>",
        "find /sys/devices/ -type f -name 'life_time*' | sed -e ':a;N;$!ba;s/\\n/ /g'",
        "find /sys/devices/ -type f -name 'lifetime*' | sed -e ':a;N;$!ba;s/\\n/ /g'",
        "cat /proc/ufs_health 2>/dev/null"
      ],
      "ufs_health": {
        "attributes": ["DeviceLifeTimeEstA", "DeviceLifeTimeEstB"],
        "accepted_values": ["0x02", "0X2", "2"],
        "normalization": "lowercase two-digit hex before percent mapping",
        "zero_values": "0x00/0x00 is skipped and the next scan source is tried"
      },
      "read": "cat <first path>",
      "split": "whitespace",
      "keys": {
        "disk_hex_1a": "values[0]",
        "disk_hex_1b": "values[1]",
        "disk_hex_2a": "values[2] when >= 4 values",
        "disk_hex_2b": "values[3] when >= 4 values",
        "disk_single_hex": "values[0] when only one value",
        "disk_node_a": "paths[0]",
        "disk_node_b": "paths[1]",
        "disk_single_node": "full path when only one value",
        "disk_health_type": "eMMC or UFS string resource"
      }
    },
    "percent_mapping": {
      "0x01": 100, "0x02": 90, "0x03": 80, "0x04": 70, "0x05": 60,
      "0x06": 50, "0x07": 40, "0x08": 30, "0x09": 20, "0x0a": 10,
      "0x0b": 1,
      "display_eol": "0x0b / 0x0B renders 'EOL'",

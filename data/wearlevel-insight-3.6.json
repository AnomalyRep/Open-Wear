  "data_sources": [
    {
      "id": "emmc_life_time",
      "storage": "eMMC",
      "command": "find /sys/block/mmcblk0/device/ -type f -name 'life_time'",
      "follow_up": "cat <path>",
      "raw_format_example": "0x01 0x02",
      "fields": ["LIFE_TIME_EST_TYP_A", "LIFE_TIME_EST_TYP_B"]
    },
    {
      "id": "ufs_health",
      "storage": "UFS",
      "command": "/system/bin/insmod /data/adb/wearlevel/ufshealth.ko 2>/dev/null; echo /proc/ufs_health",
      "follow_up": "cat /proc/ufs_health",
      "fields": ["lifetime A", "lifetime B"],
      "note": "Requires the vendor kernel module ufshealth.ko at /data/adb/wearlevel/ufshealth.ko."
    },
    {
      "id": "lifetime_nodes",
      "storage": "UFS/other",
      "command": "find /sys/devices/ -type f -name 'lifetime*' | sed -e ':a;N;$!ba;s/\\n/ /g'",
      "follow_up": "cat <path>"
    },
    {
      "id": "diskstats",
      "storage": "usage categories",
      "command": "dumpsys diskstats | grep '<category> Size'",
      "categories": ["App Size", "App Cache Size", "Audio Size", "Downloads Size", "Other Size", "Photos Size", "System Size", "Videos Size"]
    },
    {
      "id": "cpuinfo",
      "command": "cat /proc/cpuinfo",
      "parser": "line starting with 'Hardware' -> substring after ':'"
    },
    {
      "id": "gpu_model",
      "command": "cat /sys/class/kgsl/kgsl-3d0/gpu_model",
      "fallback": "GLES20.glGetString(GL_RENDERER)"
    },
    {
      "id": "battery_charge_full",
      "command": "cat /sys/class/power_supply/battery/charge_full | cut -c1-4",
      "unit": "uAh, divided by 1000 for mAh"
    },
    {
      "id": "power_profile",
      "command": "reflection: com.android.internal.os.PowerProfile#getBatteryCapacity()"
    }
  ],
  "parsing_rules": {
    "output_split": "replace 'a /s' -> 'a:/s', replace ' 0' -> ':0', split on ':'",
    "value_split": "split the cat output on ':' after replacing ' 0' with ':0'; index 0 = lifetime A code, index 1 = lifetime B code",
    "two_paths": "two paths in the command output mean multi-level-cell / two life-time sources (UFS MLC)",
    "percent_mapping": {
      "0x01": 100, "0x02": 90, "0x03": 80, "0x04": 70, "0x05": 60,
      "0x06": 50, "0x07": 40, "0x08": 30, "0x09": 20, "0x0a": 10, "0x0b": 1,
      "default": 0
    }
  },
  "storage_types": [
    "eMMC NAND-Flash Storage [High Speed Single Level Cell]",
    "UFS NAND-Flash Storage [High Speed Single Level Cell]",
    "UFS NAND-Flash Storage [Multi Level Cell]"
  ],

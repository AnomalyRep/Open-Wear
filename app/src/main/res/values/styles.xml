<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <item name="android:alertDialogTheme">@style/MaterialAlertDialogTheme</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="alertDialogTheme">@style/MaterialAlertDialogTheme</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnSurfaceInverse">@color/colorOnSurfaceInverse</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorOnTertiary">@color/colorOnTertiary</item>
        <item name="colorOnTertiaryContainer">@color/colorOnTertiaryContainer</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorPrimaryInverse">@color/colorPrimaryInverse</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorSurfaceInverse">@color/colorSurfaceInverse</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorTertiary">@color/colorTertiary</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>
        <item name="preferenceTheme">@style/PreferenceFragment.Material3</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="TextAppearanceTitle" parent="@style/TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:alpha">0.9</item>
        <item name="android:fontFamily">@font/sanfranciscoprorounded</item>
    </style>

    <style name="TextAppearanceBody" parent="@style/TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:alpha">0.9</item>
        <item name="android:fontFamily">@font/sanfranciscoprorounded</item>
    </style>

    <style name="Toolbar.TitleText" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:fontFamily">@font/sanfranciscoprorounded</item>
    </style>

    <style name="Toolbar.SubtitleText" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:fontFamily">@font/sanfranciscoprorounded</item>
    </style>

    <style name="ShapeAppearanceOverlay.MaterialCardView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomLeft">@dimen/cardCornerRadius</item>
        <item name="cornerSizeBottomRight">@dimen/cardCornerRadius</item>
        <item name="cornerSizeTopLeft">@dimen/cardCornerRadius</item>
        <item name="cornerSizeTopRight">@dimen/cardCornerRadius</item>
    </style>

    <style name="ShapeAppearanceOverlay.MaterialCardView.CutTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeTopLeft">@dimen/cardCornerRadius</item>
        <item name="cornerSizeTopRight">@dimen/cardCornerRadius</item>
    </style>

    <style name="ShapeAppearanceOverlay.MaterialCardView.CutBottom" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomLeft">@dimen/cardCornerRadius</item>
        <item name="cornerSizeBottomRight">@dimen/cardCornerRadius</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.MyApp.Dialog.Rounded" parent="">
        <item name="android:gravity">center_horizontal</item>
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="CornerCutCardView" parent="@style/Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.MaterialCardView</item>
    </style>

    <style name="TopCutCardView" parent="@style/Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.MaterialCardView.CutTop</item>
    </style>

    <style name="BottomCutCardView" parent="@style/Widget.Material3.CardView.Filled">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.MaterialCardView.CutBottom</item>
    </style>

    <style name="MyAlertDialogButtonStyle" parent="@style/Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="MaterialAlertDialogTheme" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:textColorPrimary">@color/colorOnSurface</item>
        <item name="android:textColorSecondary">@color/colorOnSurfaceVariant</item>
        <item name="android:buttonStyle">@style/MyAlertDialogButtonStyle</item>
        <item name="android:background">@color/colorSurface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.MyApp.Dialog.Rounded</item>
    </style>

    <style name="PreferenceFragment.Material3" parent="@style/PreferenceFragment">
        <item name="android:divider">@color/transparent</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.MyApp.Material3.PreferenceDialog</item>
    </style>

    <style name="ThemeOverlay.MyApp.Material3.PreferenceDialog" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/colorSurface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.MyApp.Dialog.Rounded</item>
    </style>

    <style name="PreferenceSummaryTextStyle">
        <item name="android:textAppearance">?android:textAppearanceListItemSecondary</item>
    </style>

    <style name="PreferenceCategoryTitleTextStyle">
        <item name="android:textAppearance">?preferenceCategoryTitleTextAppearance</item>
        <item name="android:textColor">?preferenceCategoryTitleTextColor</item>
    </style>

</resources>

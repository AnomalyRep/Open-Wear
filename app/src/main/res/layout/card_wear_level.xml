<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_wear_level"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Card Header: Wear Level + History button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_disk_health"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_wear_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Wear Level"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reports"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="History"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                app:cornerRadius="17dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant" />
        </LinearLayout>

        <!-- Non-root placeholder -->
        <TextView
            android:id="@+id/tv_need_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="32dp"
            android:text="@string/need_root_access"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- Two columns: Wear Level A (pSLC) | Wear Level B (TLC/MLC) -->
        <LinearLayout
            android:id="@+id/row_wear_columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Column A -->
            <LinearLayout
                android:id="@+id/col_wear_a"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title_wear_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wear Level A (pSLC)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="12dp" />

                <id.openwear.diskhealth.ui.view.RingGaugeView
                    android:id="@+id/gauge_wear_a"
                    android:layout_width="96dp"
                    android:layout_height="96dp" />
            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?attr/colorOutlineVariant"
                android:alpha="0.25"
                android:layout_marginHorizontal="8dp" />

            <!-- Column B -->
            <LinearLayout
                android:id="@+id/col_wear_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title_wear_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wear Level B (TLC/MLC)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="12dp" />

                <id.openwear.diskhealth.ui.view.RingGaugeView
                    android:id="@+id/gauge_wear_b"
                    android:layout_width="96dp"
                    android:layout_height="96dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
